generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RemediationDeliveryStatus {
  PREPARED
  COMMITTED
  PUSHED
  FAILED
}

model VerifiedRemediationArtifact {
  id String @id @default(cuid())

  repositoryIdentity String

  format String

  sha256   String
  byteSize Int

  // Trusted source-bearing content.
  //
  // This field must never be exposed through
  // public API serialization.
  content String

  // Ingestion evidence only, never standing authorization for Git mutation.
  sourceCommitSha String?
  sourceBranch String?
  ingestionSource String?
  ingestionRemoteVerified Boolean @default(false)

  createdAt DateTime @default(now())

  deliveries RemediationDelivery[]
  deliveryRequest RemediationDeliveryRequest?

  @@index([sha256])
  @@index([repositoryIdentity])
  @@index([createdAt])
}

// One claim per immutable artifact. A lost worker never grants a new mutation attempt.
model RemediationDeliveryRequest {
  artifactId String @id
  artifact VerifiedRemediationArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  developerGitHubId String
  repositoryIdentity String
  deliveryId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GitHubPullRequestDeliveryStatus {
  CLAIMED
  POST_ATTEMPTED
  VERIFIED
}

model GitHubPullRequestDelivery {
  deliveryId String @id
  delivery RemediationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  provider String @default("github")
  repositoryIdentity String
  status GitHubPullRequestDeliveryStatus @default(CLAIMED)

  prNumber Int?
  prUrl String?
  prState String?

  createdAt DateTime @default(now())
  attemptedAt DateTime?
  verifiedAt DateTime?
  reconciledAt DateTime?

  @@unique([provider, repositoryIdentity, prNumber])
  @@index([status])
}

model RemediationDelivery {
  id String @id @default(cuid())

  artifactId String

  artifact VerifiedRemediationArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  pullRequestDelivery GitHubPullRequestDelivery?

  status RemediationDeliveryStatus @default(PREPARED)

  repositoryIdentity String

  originalHead String

  sourceBranch String

  branchName String

  preparedDiffSha256 String

  commitSha String?

  remoteName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  committedAt DateTime?
  pushedAt    DateTime?

  @@index([artifactId])
  @@index([repositoryIdentity])
  @@index([status])
  @@index([commitSha])
  @@index([createdAt])
}

NEBIUS_API_KEY=
TAVILY_API_KEY=

# PostgreSQL connection used by Prisma.
DATABASE_URL=

# At least 32 bytes; required for signed developer sessions.
DEPLOYGUARD_SESSION_SECRET=

# GitHub App OAuth and installation access.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_OAUTH_REDIRECT_URI=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Optional: enables the GitHub App installation link in the UI.
GITHUB_APP_SLUG=
